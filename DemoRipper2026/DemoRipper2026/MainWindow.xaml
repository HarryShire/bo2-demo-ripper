<Window x:Class="DemoRipper2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BO2 Demo Ripper" Height="720" Width="600"
        Background="#FF15120B" Foreground="#FFE6D6AE" Icon="walleye.ico" BorderThickness="4"
        FontFamily="Bahnschrift, Segoe UI" FontStretch="SemiCondensed">
  <Window.BorderBrush>
    <!-- the walleye's edge: olive gold back, brown flank, dark mottling -->
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFB08A3A" Offset="0"/>
      <GradientStop Color="#FF6B4A22" Offset="0.5"/>
      <GradientStop Color="#FF3A2A14" Offset="1"/>
    </LinearGradientBrush>
  </Window.BorderBrush>

  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFE6D6AE"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FF2C2516"/>
      <Setter Property="Foreground" Value="#FFE6D6AE"/>
      <Setter Property="BorderBrush" Value="#FF5A3D1A"/>
      <Setter Property="CaretBrush" Value="#FFE8C877"/>
      <Setter Property="SelectionBrush" Value="#FFC9A45C"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Edge" CornerRadius="3" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#FFC9A45C"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#FF9C7A3C"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#FF2C2516"/>
      <Setter Property="Foreground" Value="#FFE6D6AE"/>
      <Setter Property="BorderBrush" Value="#FF5A3D1A"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#FF6B4A22"/>
      <Setter Property="Foreground" Value="#FFF3E6C4"/>
      <Setter Property="BorderBrush" Value="#FF9C7A3C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Face" CornerRadius="5" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
              <Border x:Name="Glow" CornerRadius="5" Background="#33E8C877" Opacity="0"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Glow" Property="Opacity" Value="1"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Glow" Property="Background" Value="#33000000"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BarThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="T" CornerRadius="4" Background="#FF6B4A22" BorderBrush="#FF9C7A3C" BorderThickness="1"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#FF8A6230"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="#FFC9A45C"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BarPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="#FF1C170E"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="1">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource BarPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource BarThumb}" Margin="1,2"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource BarPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="MinHeight" Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="1">
                  <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource BarPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource BarThumb}" Margin="2,1"/></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource BarPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                  </Track>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="FishButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF8A6230" Offset="0"/>
            <GradientStop Color="#FF6B4A22" Offset="0.45"/>
            <GradientStop Color="#FF4A3216" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="BorderBrush" Value="#FFD9B66A"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Foreground" Value="#FFF6E8C4"/>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Foreground" Value="#FFC9A45C"/>
      <Setter Property="Background" Value="#FF241E12"/>
      <Setter Property="BorderBrush" Value="#FF5A3D1A"/>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="#FFE6D6AE"/>
    </Style>
    <!-- Combo boxes keep Windows' light look, so their text must be dark. The
         light TextBlock style above otherwise reaches the text of items that
         aren't plain strings (the map list), leaving it white on white. -->
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="Black"/>
      <Style.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="Black"/></Style>
      </Style.Resources>
    </Style>
  </Window.Resources>

  <Grid>
  <!-- Background particle animation: low res, pixel art, gold; feathered, quiet, light on the CPU. Petals.cs. -->
  <Image x:Name="PetalLayer" Stretch="Fill" IsHitTestVisible="False" Opacity="0.55"
         RenderOptions.BitmapScalingMode="NearestNeighbor"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18">

      <!-- CONNECTION -->
      <TextBlock x:Name="ConnectionText" Text="Not connected"
                 Foreground="#FFD9893A" FontWeight="Bold" Margin="0,0,0,14"/>

      <!-- FIRST RUN: pick the library -->
      <Border x:Name="SetupPanel" Background="#FF241E12" BorderBrush="#FF5A3D1A"
              BorderThickness="1" Padding="14" Margin="0,0,0,16" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Where should demos be saved?" FontWeight="Bold" Margin="0,0,0,4"/>
          <TextBlock Text="Every clip gets its own folder inside this one. Set once — it's remembered."
                     Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <Button x:Name="SetupChooseButton" Content="Choose folder…" Padding="16,5"
                  HorizontalAlignment="Left" Click="ChooseLibrary_Click"/>
        </StackPanel>
      </Border>

      <!-- CLIP NAME: [player] - [map] - [kills] [gun] [notable animation] start - end -->
      <Grid Margin="0,0,0,4">
        <TextBlock Text="Clip name" Opacity="0.7"/>
        <TextBlock x:Name="NameWarningText" Text="Name the clip first" Foreground="#FFE0904A"
                   FontWeight="Bold" HorizontalAlignment="Right" Visibility="Collapsed"/>
      </Grid>
      <Grid Margin="0,0,0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140"/><ColumnDefinition Width="4"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
          <ColumnDefinition Width="56"/><ColumnDefinition Width="6"/>
          <ColumnDefinition Width="130"/><ColumnDefinition Width="6"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ComboBox  Grid.Column="0" x:Name="PlayerCombo" IsEditable="True" IsTextSearchEnabled="False"
                   VerticalContentAlignment="Center" SelectionChanged="PlayerCombo_SelectionChanged"
                   ToolTip="The player's in-game name. With auto ticked it follows the player you are watching in the theater; type a name or pick one from the list to set it yourself."/>
        <TextBlock Grid.Column="0" x:Name="PlayerPlaceholder" Text="player"
                   Foreground="#FF8C7B58" IsHitTestVisible="False"
                   VerticalAlignment="Center" Margin="6,0,0,0"/>
        <CheckBox  Grid.Column="2" x:Name="AutoPlayerBox" Content="auto" IsChecked="True"
                   VerticalAlignment="Center" Click="AutoPlayerBox_Click"
                   ToolTip="Fill the player from the game: the player being watched in the theater."/>
        <TextBox   Grid.Column="4" x:Name="KillsBox" TextChanged="NameField_TextChanged"/>
        <TextBlock Grid.Column="4" x:Name="KillsPlaceholder" Text="kills"
                   Foreground="#FF8C7B58" IsHitTestVisible="False"
                   VerticalAlignment="Center" Margin="6,0,0,0"/>
        <ComboBox  Grid.Column="6" x:Name="MapCombo" SelectionChanged="MapCombo_SelectionChanged"
                   VerticalContentAlignment="Center"
                   ToolTip="Follows the demo loaded in BO2. Pick another map to override it for this demo."/>
        <TextBox   Grid.Column="8" x:Name="DetailsBox" TextChanged="NameField_TextChanged"/>
        <TextBlock Grid.Column="8" x:Name="DetailsPlaceholder" Text="gun, notable animation"
                   Foreground="#FF8C7B58" IsHitTestVisible="False"
                   VerticalAlignment="Center" Margin="6,0,0,0"/>
      </Grid>
      <TextBlock x:Name="NamePreviewText" Text="" FontSize="11" Opacity="0.45"
                 TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>

      <!-- TIMES -->
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Start" Opacity="0.7" Margin="0,0,0,4"/>
          <TextBox x:Name="StartBox" Text="0:00" TextChanged="TimeBox_TextChanged"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="End" Opacity="0.7" Margin="0,0,0,4"/>
          <TextBox x:Name="EndBox" Text="0:00" TextChanged="TimeBox_TextChanged"/>
        </StackPanel>
      </Grid>

      <!-- DEMO TIME BAR (display only): the whole replay, the playhead, the clips, the jump points
           laid so far, and "Unknown" past what has been played. -->
      <Grid Height="20" Margin="5,8,5,1">
        <TextBlock Text="Replay timeline" FontSize="10" Opacity="0.55" VerticalAlignment="Bottom"/>
        <Canvas x:Name="DemoBarTime" IsHitTestVisible="False"/>
      </Grid>
      <Grid Height="18" Margin="5,0,5,0">
        <Canvas x:Name="DemoBar" ClipToBounds="True" SizeChanged="DemoBar_SizeChanged"/>
        <!-- the not-loaded stretch: ONE element, only resized, so its hover text can open
             (redrawn twice a second, a fresh element never lived long enough to show it) -->
        <Rectangle x:Name="DemoBarUnknown" HorizontalAlignment="Left" Visibility="Collapsed"
                   ToolTipService.InitialShowDelay="150">
          <Rectangle.ToolTip>
            <StackPanel MaxWidth="280">
              <TextBlock Text="Not loaded yet" FontWeight="Bold" Foreground="Black"/>
              <TextBlock Text="Play through this part of the replay once, and you'll be able to jump to it."
                         TextWrapping="Wrap" Foreground="Black"/>
            </StackPanel>
          </Rectangle.ToolTip>
        </Rectangle>
        <Canvas x:Name="DemoBarTop" ClipToBounds="True" IsHitTestVisible="False"/>
      </Grid>
      <Slider x:Name="StartSlider" Minimum="0" Maximum="720" Value="0"
              SmallChange="1" LargeChange="15" Margin="0,6,0,0"
              ValueChanged="StartSlider_ValueChanged"/>
      <Slider x:Name="EndSlider" Minimum="0" Maximum="720" Value="0"
              SmallChange="1" LargeChange="15" Margin="0,2,0,4"
              ValueChanged="EndSlider_ValueChanged"/>
      <TextBlock x:Name="RangeText" Text="0:00  →  0:00" Opacity="0.6"
                 FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,2"/>
      <TextBlock x:Name="TickText" Text="" Opacity="0.45" FontSize="11"
                 HorizontalAlignment="Center" Margin="0,0,0,8"/>

      <!-- IN / OUT MARKS: live replay tick, set from here or numpad * and - -->
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Button x:Name="MarkInButton" Content="Set start tick" Padding="10,2" FontSize="11" Click="MarkInButton_Click" Visibility="Collapsed"/>
          <Button x:Name="GoToStartButton" Content="Go to" Padding="8,2" FontSize="11" Margin="4,0,0,0"
                  Click="GoToStartButton_Click"
                  ToolTip="Jumps the replay to the start tick and pauses there, using BO2's theater keys (numpad +)."/>
          <TextBlock x:Name="MarkInText" Text="not set" FontSize="11" Opacity="0.7"
                     VerticalAlignment="Center" Margin="8,0,0,0"
                     ToolTip="The slider's time is the start. Numpad * during the replay sets it to the exact tick."/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock x:Name="MarkOutText" Text="not set" FontSize="11" Opacity="0.7"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Button x:Name="MarkOutButton" Content="Set end tick" Padding="10,2" FontSize="11" Click="MarkOutButton_Click" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>

      <!-- MORE CLIPS FROM THE SAME DEMO: built in code, one panel each. -->
      <StackPanel x:Name="ExtraClipsPanel"/>
      <!-- Always visible, so people see it right away, and always under the last clip. -->
      <Button x:Name="AddClipButton" Content="+  Queue for Recording" Padding="18,7" FontSize="15" FontWeight="Bold"
              HorizontalAlignment="Stretch" Margin="0,0,0,12" Click="AddClipButton_Click"
              ToolTip="Queue another clip from this demo. FISH then records every queued clip in turn (jump to it, record it, next) and saves them all in one folder with the demo."/>

      <!-- ACTIONS: FISH, one big button with the fish icon laid on it:
           records every queued clip and rips the demo into the clip folder, in one press. Pulses green
           when everything is in place. Read demo / rip without recording live under maintenance. -->
      <Grid Margin="0,0,0,2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" CornerRadius="8" BorderBrush="#40C9A45C" BorderThickness="3" Margin="-3" IsHitTestVisible="False"/>
        <Button Grid.Column="0" x:Name="RecordButton" Style="{StaticResource FishButton}" Height="108" FontSize="30" FontWeight="Bold"
                HorizontalContentAlignment="Center" Click="RecordButton_Click"
                ToolTip="FISH: records the clip(s) and rips the demo into its folder (numpad /).">
          <Grid x:Name="RecordIdleLabel">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Image Source="fish_button.png" Height="80" Margin="0,0,20,0" RenderOptions.BitmapScalingMode="HighQuality"/>
              <Grid VerticalAlignment="Center">
                <TextBlock x:Name="RecordLabelA" Style="{x:Null}" Text="FISH" FontSize="56" FontStretch="Condensed" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="RecordLabelB" Style="{x:Null}" Text="FISH" FontSize="56" FontStretch="Condensed" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="0"/>
              </Grid>
            </StackPanel>
          </Grid>
        </Button>
        <!-- A fishing net on the FISH button: a faint gold diamond mesh with knots, over the button
             (the fish is in the net); clicks pass through. -->
        <Border Grid.Column="0" CornerRadius="5" IsHitTestVisible="False" Opacity="0.22" Margin="2">
          <Border.Background>
            <DrawingBrush TileMode="Tile" Viewport="0,0,26,18" ViewportUnits="Absolute" Stretch="None">
              <DrawingBrush.Drawing>
                <DrawingGroup>
                  <GeometryDrawing Brush="#00000000" Geometry="M0,0 L26,0 L26,18 L0,18 Z"/>
                  <GeometryDrawing Geometry="M0,9 L13,0 L26,9 L13,18 Z">
                    <GeometryDrawing.Pen><Pen Brush="#FFE8C877" Thickness="0.9"/></GeometryDrawing.Pen>
                  </GeometryDrawing>
                  <GeometryDrawing Brush="#FFF0DFB0">
                    <GeometryDrawing.Geometry>
                      <GeometryGroup>
                        <EllipseGeometry Center="13,0" RadiusX="1.3" RadiusY="1.3"/>
                        <EllipseGeometry Center="0,9" RadiusX="1.3" RadiusY="1.3"/>
                        <EllipseGeometry Center="26,9" RadiusX="1.3" RadiusY="1.3"/>
                        <EllipseGeometry Center="13,18" RadiusX="1.3" RadiusY="1.3"/>
                      </GeometryGroup>
                    </GeometryDrawing.Geometry>
                  </GeometryDrawing>
                </DrawingGroup>
              </DrawingBrush.Drawing>
            </DrawingBrush>
          </Border.Background>
        </Border>
        <Button Grid.Column="1" x:Name="DiscardButton" Content="Discard take" Padding="12,5"
                Margin="8,0,0,0" Visibility="Collapsed" Click="DiscardButton_Click"/>
      </Grid>
      <!-- The tiny caption, outside the button: under it, at the right. -->
      <TextBlock FontSize="8" Opacity="0.6" HorizontalAlignment="Right" Margin="0,0,4,4">
        <Run Text="(Save Demo and Record Previews)"/>
      </TextBlock>
      <TextBlock x:Name="RecordText" Text="" FontSize="11" Opacity="0.7"
                 TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
      <ProgressBar x:Name="RipProgress" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,4,0,12"/>

      <!-- Advanced: hotkeys, the recording switches, the log, Saved as, the library, Recording and
           Offsets and maintenance. -->
      <Expander x:Name="AdvancedExpander" Header="Advanced" IsExpanded="False" Margin="0,0,0,0">
        <StackPanel Margin="0,8,0,0">
      <TextBlock x:Name="HotkeyText" Text="" FontSize="11" Opacity="0.45" Margin="0,0,0,2"/>
      <CheckBox x:Name="AutoEndBox" Content="Auto End Recording at End Tick" IsChecked="True"
                FontSize="11" Foreground="#FFE6D6AE" Opacity="0.7" Margin="0,0,0,2"
                Checked="AutoEndBox_Changed" Unchecked="AutoEndBox_Changed"/>
      <CheckBox x:Name="JumpToStartBox" Content="Jump to Start Tick before recording" IsChecked="True"
                FontSize="11" Foreground="#FFE6D6AE" Opacity="0.7" Margin="0,0,0,2"
                ToolTip="When Record is pressed with a start tick set, jumps the replay to the jump point just before it (from either side) and plays. Uses BO2's theater keys; nothing is written to the game."/>
      <CheckBox x:Name="BeepBox" Content="Beep for ticks, arming, saves and problems (silent while OBS records)" IsChecked="True"
                FontSize="11" Foreground="#FFE6D6AE" Opacity="0.7" Margin="0,0,0,8"/>


      <!-- The log starts collapsed. -->
      <Expander x:Name="LogExpander" Header="Log" IsExpanded="False" Margin="0,0,0,12">
        <TextBox x:Name="InfoBox" Height="180" Margin="0,6,0,0"
                 IsReadOnly="True" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12" Text=""/>
      </Expander>

      <!-- RESULT -->
      <TextBlock Text="Saved as" Opacity="0.7" Margin="0,0,0,4"/>
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" x:Name="ResultBox" IsReadOnly="True" Text=""/>
        <Button Grid.Column="1" x:Name="CopyResultButton" Content="Copy"
                Padding="12,4" Margin="6,0,0,0" Click="CopyResult_Click"/>
        <Button Grid.Column="2" x:Name="OpenFolderButton" Content="Open folder"
                Padding="12,4" Margin="6,0,0,0" IsEnabled="False" Click="OpenFolderButton_Click"/>
      </Grid>

      <Separator Margin="0,0,0,10" Background="#FF5A3D1A"/>

      <!-- LIBRARY, once set -->
      <Grid x:Name="LibraryRow" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Clips are saved in" Opacity="0.5" FontSize="11"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock Grid.Column="1" x:Name="LibraryText" Text="(not set)" Opacity="0.5"
                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <Button Grid.Column="2" Content="Change" Padding="10,2" FontSize="11" Click="ChooseLibrary_Click"/>
      </Grid>

      <!-- RECORDING -->
      <Expander Header="Recording" Foreground="#FFE6D6AE" Margin="0,0,0,8">
        <StackPanel Margin="0,10,0,0">
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Record with" VerticalAlignment="Center"/>
            <ComboBox  Grid.Column="1" x:Name="RecorderCombo" Foreground="Black" HorizontalAlignment="Left" MinWidth="220"
                       SelectionChanged="RecorderCombo_SelectionChanged">
              <ComboBoxItem Content="Built-in recorder" Tag="builtin" IsSelected="True"/>
              <ComboBoxItem Content="OBS" Tag="obs"/>
            </ComboBox>
          </Grid>

          <!-- BUILT-IN -->
          <StackPanel x:Name="BuiltInPanel">
            <TextBlock Text="Records the BO2 window at its own size, with only BO2's sound. Play in fullscreen windowed (borderless): exclusive fullscreen may record black."
                       Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Frame rate" VerticalAlignment="Center" Margin="0,0,0,4"/>
              <TextBox   Grid.Row="0" Grid.Column="1" x:Name="FpsBox" Text="60" Margin="0,0,0,4"/>
              <TextBlock Grid.Row="0" Grid.Column="2" Text="fps" Opacity="0.5" VerticalAlignment="Center" Margin="8,0,0,4"/>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="H.264 profile" VerticalAlignment="Center" Margin="0,0,0,4"/>
              <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="ProfileCombo" Foreground="Black" Margin="0,0,0,4"
                         ToolTip="Main matches Bandicam and plays everywhere. High looks a little better at the same bitrate. Baseline is the simplest and least efficient.">
                <ComboBoxItem Content="Baseline" Tag="Baseline"/>
                <ComboBoxItem Content="Main" Tag="Main" IsSelected="True"/>
                <ComboBoxItem Content="High" Tag="High"/>
              </ComboBox>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Bitrate" VerticalAlignment="Center" Margin="0,0,0,4"/>
              <TextBox   Grid.Row="2" Grid.Column="1" x:Name="KbpsBox" Text="7470" Margin="0,0,0,4" IsEnabled="False"/>
              <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,4" VerticalAlignment="Center">
                <TextBlock Text="kbps" Opacity="0.5" VerticalAlignment="Center"/>
                <CheckBox x:Name="AutoKbpsBox" Content="Auto" IsChecked="True" Foreground="#FFE6D6AE" Margin="12,0,0,0"
                          VerticalAlignment="Center" Checked="AutoKbpsBox_Changed" Unchecked="AutoKbpsBox_Changed"
                          ToolTip="Picks the bitrate from BO2's resolution when recording starts."/>
              </StackPanel>
              <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="AutoKbpsText" FontSize="11" Opacity="0.45"
                         TextWrapping="Wrap" Margin="0,0,0,6"
                         Text="Auto: 7470 up to 1080p · 12000 at 1440p · 20000 at 4K"/>

              <TextBlock Grid.Row="4" Grid.Column="0" Text="Game volume" VerticalAlignment="Center"/>
              <Slider    Grid.Row="4" Grid.Column="1" x:Name="VolumeSlider" Minimum="-12" Maximum="30" Value="0"
                         SmallChange="1" LargeChange="6" IsSnapToTickEnabled="True" TickFrequency="1"
                         VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"
                         ToolTip="Makes BO2's sound louder or quieter in the recording only. Loud moments are softened instead of clipping."/>
              <TextBlock Grid.Row="4" Grid.Column="2" x:Name="VolumeText" Text="0 dB (as played)" Opacity="0.7"
                         VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
            <TextBlock Text="Frame rate, profile and bitrate apply from the next take. Volume applies straight away. Keyframes every 0.5 s; audio AAC 48 kHz, 192 kbps."
                       Opacity="0.45" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>

          <!-- OBS -->
          <StackPanel x:Name="ObsPanel" Visibility="Collapsed">
          <TextBlock Text="Previews record through OBS. In OBS open Tools → WebSocket Server Settings, tick Enable WebSocket server, then use Show Connect Info for the port and password."
                     Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Port" VerticalAlignment="Center" Margin="0,0,0,4"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="ObsPortBox" Text="4455" Margin="0,0,0,4"/>

            <TextBlock   Grid.Row="1" Grid.Column="0" Text="Password" VerticalAlignment="Center"/>
            <PasswordBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ObsPasswordBox"/>
          </Grid>

          <StackPanel Orientation="Horizontal">
            <Button x:Name="ObsTestButton" Content="Test connection" Padding="12,4" Click="ObsTestButton_Click"/>
          </StackPanel>
          </StackPanel>
        </StackPanel>
      </Expander>

      <!-- MAINTENANCE -->
      <Expander Header="Offsets and maintenance" Foreground="#FFE6D6AE">
        <StackPanel Margin="0,10,0,0">
          <TextBlock Text="Only needed after a Black Ops 2 update moves things."
                     Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Process" VerticalAlignment="Center" Margin="0,0,0,4"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="ProcessBox" Text="t6mp" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Demo data" VerticalAlignment="Center" Margin="0,0,0,4"
                       ToolTip="The loaded demo's data: a pointer, then its size."/>
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="OffDemoDataBox" Text="47344080" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="File name" VerticalAlignment="Center" Margin="0,0,0,4"/>
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="OffFileNameBox" Text="44940850" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Thumbnail" VerticalAlignment="Center" Margin="0,0,0,4"/>
            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="OffThumbBox" Text="44941368" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Summary" VerticalAlignment="Center" Margin="0,0,0,4"/>
            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="OffSummaryBox" Text="44589248" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Summary length" VerticalAlignment="Center" Margin="0,0,0,4"/>
            <TextBox   Grid.Row="5" Grid.Column="1" x:Name="OffSummaryLengthBox" Text="44941884" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Tick" VerticalAlignment="Center" Margin="0,0,0,4"/>
            <TextBox   Grid.Row="6" Grid.Column="1" x:Name="OffTickBox" Text="13068896" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="End tick" VerticalAlignment="Center"/>
            <TextBox   Grid.Row="7" Grid.Column="1" x:Name="OffEndTickBox" Text="46225264"/>
          </Grid>

          <TextBlock Text="Keyboard shortcuts" FontWeight="Bold" Margin="0,4,0,2"/>
          <TextBlock Text="They work while BO2 is in front. Click a box, then press the key you want (Esc keeps the old one)."
                     Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Record / stop / save" VerticalAlignment="Center" Margin="0,0,0,4"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="KeyRecordBox" IsReadOnly="True" Tag="0" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Text="Set Start time to Current Demo Time" VerticalAlignment="Center" Margin="0,0,0,4"/>
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="KeyStartBox" IsReadOnly="True" Tag="1" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="2" Text="Set End time to Current Demo Time" VerticalAlignment="Center" Margin="0,0,0,4"/>
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="KeyEndBox" IsReadOnly="True" Tag="2" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="3" Text="Go to the start time" VerticalAlignment="Center"/>
            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="KeyGoToBox" IsReadOnly="True" Tag="3"/>
            <Button    Grid.Row="3" Grid.Column="2" Content="Numpad defaults" Padding="10,2" FontSize="11" Margin="8,0,0,0"
                       HorizontalAlignment="Left" Click="KeyDefaults_Click"/>
          </Grid>

          <CheckBox x:Name="FakeActivationBox" Content="Wake BO2 before each theater key (only if jumps don't work in the background)"
                    FontSize="11" Foreground="#FFE6D6AE" Opacity="0.7" Margin="0,0,0,10"/>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="ReadButton" Content="Read demo" Padding="12,4" Margin="0,0,8,0" Click="ReadButton_Click"
                    ToolTip="Shows what DemoRipper can read of the demo loaded in BO2."/>
            <Button x:Name="RipButton" Content="Rip demo only" Padding="12,4" Margin="0,0,8,0" Click="RipButton_Click"
                    ToolTip="Saves the demo files into the clip folder without recording a preview."/>
            <Button x:Name="SaveOffsetsButton" Content="Save" Padding="12,4" Click="SaveOffsetsButton_Click"/>
            <Button x:Name="RelocateButton" Content="Relocate from known demo…" Padding="12,4"
                    Margin="8,0,0,0" Click="RelocateButton_Click"
                    ToolTip="After a BO2 update: first load, in BO2's theater, a demo you already ripped with this app. Then pick that same demo's .demo file."/>
            <Button x:Name="DiagnoseButton" Content="Diagnose" Padding="12,4"
                    Margin="8,0,0,0" Click="DiagnoseButton_Click"/>
            <Button x:Name="NoticesButton" Content="Third-party notices" Padding="12,4"
                    Margin="8,0,0,0" Click="NoticesButton_Click"
                    ToolTip="The licences of the libraries built into this exe."/>
          </StackPanel>
        </StackPanel>
      </Expander>
        </StackPanel>
      </Expander>

      <Separator Margin="0,12,0,10" Background="#FF5A3D1A"/>
      <TextBlock x:Name="StatusText" Text="Ready." TextWrapping="Wrap" FontSize="11" Opacity="0.7"/>

    </StackPanel>
  </ScrollViewer>
  </Grid>
</Window>
